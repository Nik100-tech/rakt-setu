generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum DonorStatus {
  AVAILABLE
  UNAVAILABLE
}

enum RequestStatus {
  OPEN
  MATCHED
  FULFILLED
  CLOSED
}

model Donor {
  id            Int          @id @default(autoincrement())
  token         String       @unique
  fullName      String
  phone         String       @unique
  bloodGroup    BloodGroup
  location      String
  status        DonorStatus  @default(AVAILABLE)
  donationCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  matches       Match[]
  activities    Activity[]
}

model BloodRequest {
  id            Int          @id @default(autoincrement())
  token         String       @unique
  patientName   String
  contactPhone  String
  bloodGroup    BloodGroup
  location      String
  unitsNeeded   Int          @default(1)
  status        RequestStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  matches       Match[]
  activities    Activity[]
}

model Match {
  id         Int          @id @default(autoincrement())
  donorId    Int
  requestId  Int
  matchType  String
  status     String       @default("PENDING")
  createdAt  DateTime     @default(now())
  donor      Donor        @relation(fields: [donorId], references: [id], onDelete: Cascade)
  request    BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([donorId, requestId])
  @@index([donorId])
  @@index([requestId])
}

model Activity {
  id         Int           @id @default(autoincrement())
  type       String
  message    String
  donorId    Int?
  requestId  Int?
  createdAt  DateTime      @default(now())
  donor      Donor?        @relation(fields: [donorId], references: [id], onDelete: SetNull)
  request    BloodRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
